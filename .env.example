# Supabase Client Configuration (Public / Safe for Browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-or-anon-key

# Central AI Service Configuration (Server-Side ONLY - NEVER exposed to browser)
# Supported Providers: gemini (default) | openai | openrouter
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_secret_ai_api_key_here
AI_BASE_URL=

# Provider-Specific Alternates:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
